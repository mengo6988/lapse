# Copy to .env and fill in before running `docker compose up`.

# Required. Boot fails immediately if unset or empty — see src/server/env.ts
# and docs/tech-stack.md § Boot sequence. This is the single shared password
# gating the whole app (ADR-0003 amendment: public deployment).
LAPSE_PASSWORD=

# Port the server listens on inside the container. Defaults to 3000; only
# change this if you also change the Traefik service port label in
# compose.yaml.
PORT=3000

# Directory holding lapse.db and its backups. Defaults to /data, which is
# where compose.yaml mounts the named/bind volume. Leave unset in normal
# Docker use — this only matters for running the server outside a container.
DATA_DIR=/data

# Optional. Lets non-browser callers reach /api/* with
# `Authorization: Bearer <token>` — an Apple Shortcut on the Action Button, a
# script, the Telegram bot below. NEVER reuse LAPSE_PASSWORD here: this string
# is pasted into a Shortcut in plaintext and travels with it when the Shortcut
# is exported or shared. Generate one with:
#
#     openssl rand -hex 32
#
# Minimum 32 characters. Unset means bearer auth is off and the cookie is the
# only way in. Rotating it is changing this value and restarting.
# See docs/capture.md.
LAPSE_API_TOKEN=

# Optional, and only useful together — set neither and no bot starts.
# LAPSE_TELEGRAM_BOT_TOKEN comes from @BotFather. LAPSE_TELEGRAM_CHAT_ID is
# the ONE chat allowed to talk to the bot, and is the entire authorisation
# model: anyone who finds the bot's @name can message it, and messages from
# any other chat are dropped. Get your id by messaging @userinfobot.
# See docs/capture.md.
LAPSE_TELEGRAM_BOT_TOKEN=
LAPSE_TELEGRAM_CHAT_ID=
