# Copy to .env and fill in before running `docker compose up`.

# Required. Boot fails immediately if unset or empty — see src/server/env.ts
# and docs/tech-stack.md § Boot sequence. This is the single shared password
# gating the whole app (ADR-0003 amendment: public deployment).
LAPSE_PASSWORD=

# Port the server listens on inside the container. Defaults to 3000; only
# change this if you also change the Traefik service port label in
# compose.yaml.
PORT=3000

# Directory holding lapse.db and its backups. Defaults to /data, which is
# where compose.yaml mounts the named/bind volume. Leave unset in normal
# Docker use — this only matters for running the server outside a container.
DATA_DIR=/data
